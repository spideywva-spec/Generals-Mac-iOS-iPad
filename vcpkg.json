{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "533a5fda5c0646d1771345fb572e759283444d5f",
  "vcpkg-configuration": {
    "registries": [
      {
        "kind": "git",
        "repository": "https://github.com/tintinhamans/GNS",
        "reference": "vcpkg-registry",
        "baseline": "e62d241df714253c66aaf900fed05f30c3fd433a",
        "packages": [
          "gamenetworkingsockets"
        ]
      }
    ],
    "overlay-ports": [
      "vcpkg_ports"
    ]
  },
  "dependencies": [
    "zlib",
    "glm",
    "gli",
    {
      "name": "freetype",
      "platform": "!windows"
    },
    {
      "name": "fontconfig",
      "platform": "!windows & !ios"
    },
    {
      "name": "openal-soft",
      "platform": "!windows",
      "features": []
    },
    {
      "name": "curl",
      "platform": "!windows",
      "features": [
        "ssl"
      ]
    },
    {
      "name": "ffmpeg",
      "platform": "ios",
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample"
      ]
    }
  ],
  "features": {
    "generals-online": {
      "description": "Generals Online service and next-generation multiplayer dependencies",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "ssl",
            "websockets"
          ]
        },
        {
          "name": "gamenetworkingsockets",
          "version>=": "1.6.0",
          "default-features": false,
          "features": [
            "ice"
          ]
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "8.1.1",
      "port-version": 2
    },
    {
      "name": "ffmpeg-bin2c",
      "version": "8.1.1"
    }
  ]
}
